# Public site URL, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.srenity.tech

# Google Tag Manager container ID (GTM-XXXXXXXX). Configure/publish GA4 in this container.
# Takes priority over NEXT_PUBLIC_GA_ID when both are set.
NEXT_PUBLIC_GTM_ID=

# Optional direct Google Analytics 4 measurement ID (G-XXXXXXXXXX), used only without GTM.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification token (the content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional: override where early-access sign-ups are posted.
# Defaults to FormSubmit, which emails each sign-up to contact@srenity.tech.
NEXT_PUBLIC_SIGNUP_ENDPOINT=

# The /demo login and integrations use the standalone FastAPI connector.
# Each user signs in separately. In production: https://connector.srenity.tech, locally: http://127.0.0.1:8001
SRENITY_CONNECTOR_URL=https://connector.srenity.tech

# Encrypts only the selected opaque connection reference. OAuth tokens live in the connector DB.
SRENITY_SESSION_SECRET=
